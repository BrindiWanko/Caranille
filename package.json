{
  "name": "caranille",
  "version": "0.1.0",
  "description": "Caranille - a browser-based 2D MMORPG engine with a built-in live world editor.",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run assets:build && npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsx scripts/build-client.ts",
    "start": "node dist/server/index.js",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "npm run lint:names && npm run i18n:check && node --import tsx --test \"tests/**/*.test.ts\"",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "lint:names": "tsx scripts/lint-names.ts",
    "assets:build": "tsx assets/generators/build.ts",
    "load-test": "tsx scripts/load-test.ts",
    "demo:export": "tsx scripts/export-demo.ts"
  },
  "keywords": [
    "mmorpg",
    "game-engine",
    "2d",
    "tile-map",
    "editor",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "i18n": "^0.15.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/i18n": "^0.13.12",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
