<!doctype html>
<html lang="<%= locale %>">
<head>
  <%- include('../partials/head', { title: t('auth.register.title') }) %>
</head>
<body class="site">
  <%- include('../partials/lang-switch') %>
  <main class="window form-window">
    <h1><%= t('auth.register.title') %></h1>
    <% if (isFirstAccount) { %>
      <p class="form-notice"><%= t('auth.register.first_admin') %></p>
    <% } %>
    <%- include('../partials/form-error', { errorKey, errorParams: {} }) %>
    <form method="post" action="/register" class="stacked-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <label>
        <span><%= t('auth.field.username') %></span>
        <input name="username" autocomplete="username" required autofocus
               minlength="3" maxlength="20" pattern="[A-Za-z][A-Za-z0-9_\-]{2,19}"
               value="<%= values.username || '' %>" aria-describedby="username-hint">
        <small id="username-hint"><%= t('auth.register.username_hint') %></small>
      </label>
      <label>
        <span><%= t('auth.field.email') %></span>
        <input name="email" type="email" autocomplete="email" required maxlength="254" value="<%= values.email || '' %>">
      </label>
      <label>
        <span><%= t('auth.field.password') %></span>
        <input name="password" type="password" autocomplete="new-password" required minlength="8"
               aria-describedby="password-hint">
        <small id="password-hint"><%= t('auth.register.password_hint') %></small>
      </label>
      <label>
        <span><%= t('auth.field.password_confirm') %></span>
        <input name="passwordConfirm" type="password" autocomplete="new-password" required minlength="8">
      </label>
      <% if (needsSetupCode) { %>
        <label>
          <span><%= t('auth.field.setup_code') %></span>
          <input name="setupCode" autocomplete="off" required aria-describedby="setup-code-hint">
          <small id="setup-code-hint"><%= t('auth.register.setup_code_hint') %></small>
        </label>
      <% } %>
      <button type="submit" class="button primary"><%= t('auth.register.submit') %></button>
    </form>
    <p class="form-footer"><%= t('auth.register.have_account') %> <a href="/login"><%= t('site.login') %></a></p>
  </main>
  <p class="site-footer"><a href="/"><%= t('common.back_home') %></a></p>
</body>
</html>
